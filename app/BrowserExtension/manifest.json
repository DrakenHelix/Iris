{
  "manifest_version": 3,
  "name": "Iris · Download progress",
  "version": "1.0.1",
  "description": "Shows active download progress in Iris on this PC.",
  "key": "",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "24": "icon24.png",
      "32": "icon32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Iris Downloads"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
